# Copia este archivo como .env (en la raíz del repositorio) y pon tu clave de Gemini:
# https://aistudio.google.com/apikey
# Solo la usa el asistente del tablero; sin ella todo lo demás funciona.
APIGEMINI=

# Opcionales (ver "Asistente" en motor-procesamiento/README.md)
# GEMINI_MODELO=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_EMBEDDINGS=gemini-embedding-2
# GEMINI_RAZONAMIENTO=low
